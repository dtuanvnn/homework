# Postgres connection string. Supabase cloud: use the "Transaction pooler" URL (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Server-only key used for Storage. Supabase cloud: use the legacy "service_role" JWT
# (Project Settings → API keys → Legacy); Storage rejects the new sb_secret_ keys with "Invalid Compact JWS".
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=homework
# Optional: require this PIN before the app opens. Leave empty to disable.
APP_PIN=
# AI features (scan, generate, grade, summarize). Set one key; AI_PROVIDER picks
# explicitly ("deepseek" | "anthropic"), otherwise DeepSeek is used when its key is set.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
