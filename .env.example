# Postgres connection string. Supabase cloud: use the "Session pooler" URL (port 5432), not the transaction pooler.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Server-only key used for Storage uploads (Project Settings → API keys → secret key).
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=homework
# Optional: require this PIN before the app opens. Leave empty to disable.
APP_PIN=
# AI features (scan, generate, grade, summarize). Set one key; AI_PROVIDER picks
# explicitly ("deepseek" | "anthropic"), otherwise DeepSeek is used when its key is set.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
